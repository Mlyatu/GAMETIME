# ==============================
# SERVER CONFIGURATION
# ==============================
# In production, set NODE_ENV=production, use public HTTPS URLs for
# CLIENT_URL and APP_URL, and use hosted PostgreSQL plus unique JWT secrets
# (at least 32 characters each). Production startup validates these values.
NODE_ENV=development
PORT=5000
# Exact origins are used in production; development also allows HTTP loopback origins on any port.
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ==============================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================
DB_HOST=localhost
DB_PORT=5432
DB_USER=efootball_user
DB_PASSWORD=change_this_password
DB_NAME=efootball_arena
DB_SSL=false

# ==============================
# JWT AUTHENTICATION
# ==============================
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# ==============================
# EMAIL (for verification / password reset)
# ==============================
# Leave SMTP_HOST empty for "dev email" mode: signups are auto-verified
# and verification/reset emails go to a free Ethereal test inbox (the
# forgot-password page shows a button to open them). To send REAL emails,
# fill in real SMTP credentials (e.g. a Gmail App Password) and restart.
# Production startup requires real SMTP_HOST, SMTP_USER, and SMTP_PASS.
# SMTP_HOST=smtp.gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="EFootball Arena <no-reply@efootballarena.com>"

# ==============================
# OCR (Tesseract.js)
# ==============================
# Tesseract.js downloads its English model from a CDN on first use by
# default — leave OCR_LANG_PATH unset for that (normal case with
# internet access). If your server can't reach that CDN, download
# eng.traineddata yourself (e.g. from the tesseract-ocr/tessdata
# project) into a local folder and point OCR_LANG_PATH at it.
# OCR_LANG_PATH=/path/to/tessdata
# OCR_LANG_GZIP=false

# ==============================
# FILE UPLOADS
# ==============================
UPLOAD_MAX_SIZE_MB=10
MEDIA_MAX_SIZE_MB=50
UPLOAD_DIR=uploads
# In production, set UPLOAD_DIR to the absolute path of a persistent volume.

# ==============================
# RATE LIMITING
# ==============================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=10
