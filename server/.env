# ==============================
# SERVER CONFIGURATION
# ==============================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ==============================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================
DB_HOST=localhost
DB_PORT=5432
DB_USER=efootball_user
DB_PASSWORD=change_this_password
DB_NAME=efootball_arena
DB_SSL=false

# ==============================
# JWT AUTHENTICATION
# ==============================
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# ==============================
# EMAIL (for verification / password reset)
# ==============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="EFootball Arena <no-reply@efootballarena.com>"

# ==============================
# OCR (Tesseract.js)
# ==============================
# Tesseract.js downloads its English model from a CDN on first use by
# default — leave OCR_LANG_PATH unset for that (normal case with
# internet access). If your server can't reach that CDN, download
# eng.traineddata yourself (e.g. from the tesseract-ocr/tessdata
# project) into a local folder and point OCR_LANG_PATH at it.
# OCR_LANG_PATH=/path/to/tessdata
# OCR_LANG_GZIP=false

# ==============================
# FILE UPLOADS
# ==============================
UPLOAD_MAX_SIZE_MB=10
MEDIA_MAX_SIZE_MB=50
UPLOAD_DIR=uploads

# ==============================
# RATE LIMITING
# ==============================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
